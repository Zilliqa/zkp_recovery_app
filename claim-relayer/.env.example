# --- Chain / escrow ---
RPC_URL=https://api.zilliqa.com/zq2                 # JSON-RPC endpoint (Zilliqa EVM)
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000  # the Groth16Verifier-inheriting escrow
RELAYER_PRIVATE_KEY=0x...                            # pays gas only; CANNOT redirect funds (destination is bound in each proof)

# --- Google Sheet (the Form's linked responses sheet) ---
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json  # service-account JSON key; share the Sheet with its email (Viewer)
SHEET_ID=your_spreadsheet_id                         # from the Sheet URL: /spreadsheets/d/<SHEET_ID>/edit
SHEET_RANGE=Form Responses 1!A:Z                     # only the tab name is used; the calldata column is auto-located by CALLDATA_COLUMN
CALLDATA_COLUMN=Calldata                             # exact header of the column holding the 0x calldata

# --- Local state ---
CURSOR_FILE=./.cursor                                # tracks how many rows have been processed (idempotency)

# --- Testing only (see e2e-anvil/) ---
# CALLDATA_FILE=./calldata.txt                        # read calldata from a local file instead of the Sheet (SHEET_ID then unused)
